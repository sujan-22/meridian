# --- Database -----------------------------------------------------------
# Local: the Docker Postgres in this repo.
# Neon:  copy the POOLED connection string (the host contains "-pooler").
DATABASE_URL=postgresql://quanta:quanta@localhost:5432/quanta

# Neon only. The DIRECT (unpooled) string, used for migrations - DDL through
# PgBouncer is unreliable. Leave unset locally.
# DATABASE_URL_UNPOOLED=

# --- App ----------------------------------------------------------------
# Used for absolute URLs in metadata. On Vercel set this to your domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000
